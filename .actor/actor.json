{
  "$schema": "https://apify.com/schemas/v1/actor.ide.json",
  "actorSpecification": 1,
  "name": "mawsool-linkedin-profile-education",
  "title": "LinkedIn Education Scraper",
  "description": "Get LinkedIn education from profile URLs: school, degree, field of study, years, and school URL. From $1 per 1,000 profiles.",
  "seoTitle": "LinkedIn Education Scraper",
  "seoDescription": "Scrape LinkedIn education: school, degree, field, years, and school URL. $1 per 1,000 profiles.",
  "categories": [
    "LEAD_GENERATION",
    "SOCIAL_MEDIA"
  ],
  "version": "1.0",
  "buildTag": "latest",
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 1024,
  "defaultRunOptions": {
    "build": "latest",
    "timeoutSecs": 21600,
    "memoryMbytes": 256
  },
  "environmentVariables": {
    "ACTOR_SLICE": "education",
    "CHARGE_EVENT": "profile-education",
    "GUEST_API_KEY": "@mawsoolGuestApiKey"
  },
  "meta": {
    "templateId": "ts-empty",
    "generatedBy": "Cursor Agent"
  },
  "input": "./input_schema.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": "./dataset_schema.json"
  },
  "pricing": "./pay_per_event.json",
  "dockerfile": "../Dockerfile"
}
